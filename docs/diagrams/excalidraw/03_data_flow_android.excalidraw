      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "• Retrofit Response.isSuccessful()\n  → NetworkResult.Success\n  → false → NetworkResult.Error(httpCode + msg)\n• IOException / Timeout caught in repo\n  → NetworkResult.Error(\"network\")\n• 401 → repo returns Error(\"UNAUTHORIZED\")\n  UI layer can clear token, route to Login",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "• Retrofit Response.isSuccessful()\n  → NetworkResult.Success\n  → false → NetworkResult.Error(httpCode + msg)\n• IOException / Timeout caught in repo\n  → NetworkResult.Error(\"network\")\n• 401 → repo returns Error(\"UNAUTHORIZED\")\n  UI layer can clear token, route to Login",
      "autoResize": true,
      "lineHeight": 1.25
    },
