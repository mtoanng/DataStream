      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Polling loop\n(HomeViewModel)\n\nwhile (true) {\n  refresh()\n  delay(\n    appConfig.refreshIntervalSeconds\n    * 1000L\n  )\n}\n\nDefault: 30 s\n(Settings: 5–600 s)\n\nstopAutoRefresh()\nin onCleared() / onPause()",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "containerId": null,
      "originalText": "Polling loop\n(HomeViewModel)\n\nwhile (true) {\n  refresh()\n  delay(\n    appConfig.refreshIntervalSeconds\n    * 1000L\n  )\n}\n\nDefault: 30 s\n(Settings: 5–600 s)\n\nstopAutoRefresh()\nin onCleared() / onPause()",
      "autoResize": true,
      "lineHeight": 1.25
    },
