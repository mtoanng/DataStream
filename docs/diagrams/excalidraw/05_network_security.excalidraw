      "seed": 151691,
      "version": 1,
      "versionNonce": 40548,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "baseUrl  (AppConfig · SharedPreferences)\n\nDefault                http://10.0.2.2:8090/    (Android Emulator → host)\nReal device same WiFi  http://<laptop-LAN-IP>:8090/    (must add IP to network_security_config!)\nMock server            http://10.0.2.2:3001/    (json-server in mock/ folder)\nEditable in            SettingsFragment → save → NetworkModule.recreate()\n\nPublic deployments MUST use https:// — base-config blocks cleartext otherwise.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 11,
      "containerId": "rect-42",
      "originalText": "baseUrl  (AppConfig · SharedPreferences)\n\nDefault                http://10.0.2.2:8090/    (Android Emulator → host)\nReal device same WiFi  http://<laptop-LAN-IP>:8090/    (must add IP to network_security_config!)\nMock server            http://10.0.2.2:3001/    (json-server in mock/ folder)\nEditable in            SettingsFragment → save → NetworkModule.recreate()\n\nPublic deployments MUST use https:// — base-config blocks cleartext otherwise.",
      "autoResize": true,
      "lineHeight": 1.25
    },
