    {
      "id": "text-43",
      "type": "text",
      "x": 708,
      "y": 610,
      "width": 584,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
