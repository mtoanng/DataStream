      "link": null,
      "locked": false,
      "text": "Repositories  (5)  data/repository/\n\n• AuthRepository           login, me, logout\n• SecurityRepository       /security/score\n• PillarRepository         /pillars/{1..4}\n• AlertRepository          /alerts/active, ack\n• RecommendationRepository /recommendations\n\nReturns NetworkResult<Success | Error | Loading>",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "baseline": 12,
      "containerId": "rect-13",
      "originalText": "Repositories  (5)  data/repository/\n\n• AuthRepository           login, me, logout\n• SecurityRepository       /security/score\n• PillarRepository         /pillars/{1..4}\n• AlertRepository          /alerts/active, ack\n• RecommendationRepository /recommendations\n\nReturns NetworkResult<Success | Error | Loading>",
      "autoResize": true,
      "lineHeight": 1.25
    },
