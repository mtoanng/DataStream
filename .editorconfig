# EditorConfig — DataStream (Android)
# https://editorconfig.org/
#
# Standard Android conventions: 4-space indent for Java/Kotlin/XML,
# 2-space for Markdown/YAML/JSON, LF line-endings universally.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

# Kotlin / Java — strict 4-space, official Kotlin style
[*.{kt,kts,java}]
indent_size = 4
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true

# Android XML resources — keep AS's default 4-space
[*.xml]
indent_size = 4

# Gradle scripts (Groovy or Kotlin DSL)
[*.{gradle,gradle.kts}]
indent_size = 4

# Web-style configs — 2-space convention
[*.{md,markdown,yml,yaml,json,toml,html,css,js,ts}]
indent_size = 2

# Shell + batch — preserve native EOL via .gitattributes; here just keep tabs visible
[*.{sh,bash}]
indent_size = 4
end_of_line = lf

[*.{bat,cmd,ps1}]
indent_size = 4
end_of_line = crlf

# Generated files: don't fight the generator
[gradle/wrapper/**]
insert_final_newline = false
trim_trailing_whitespace = false
