<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security config for VES-Monitor dev/prod.

    Cleartext HTTP is whitelisted ONLY for local development backends
    (emulator host loopback + common private LAN ranges). Anything else
    (public internet) MUST use HTTPS — enforced by the <base-config>.

    Android's <domain> tag accepts literal hostnames or literal IP
    addresses. CIDR ranges are NOT supported. If the user's laptop sits
    on a subnet outside the ones listed below (e.g. 192.168.5.x), they
    must add their LAN IP here — see TROUBLESHOOTING.md §11.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator's loopback to host machine -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>

        <!-- Common LAN ranges used by home routers. -->
        <!-- 192.168.0.x, 192.168.1.x, 192.168.2.x, 192.168.4.x, 192.168.50.x, 192.168.100.x -->
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.2.1</domain>
        <domain includeSubdomains="false">192.168.4.1</domain>
        <domain includeSubdomains="false">192.168.50.1</domain>
        <domain includeSubdomains="false">192.168.100.1</domain>

        <!-- Corporate / Bosch-style 10.x.x.x slash-8 — leave a few -->
        <domain includeSubdomains="false">10.0.0.1</domain>
        <domain includeSubdomains="false">10.1.0.1</domain>

        <!-- 🛠 ADD YOUR LAN IP HERE for real-device testing, e.g.:
             <domain includeSubdomains="false">192.168.1.42</domain>
        -->
    </domain-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
